# Discord
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
# Optional: separate channel for YouTube, Instagram and X videos. Blank disables it.
DISCORD_SOCIAL_ID=
# Optional: when set, /upload is (re)registered in this guild on startup.
DISCORD_GUILD_ID=
OWNER_ID=

# Cloudflare R2 (S3-compatible API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket base (custom domain or r2.dev), never the S3 API endpoint.
R2_PUBLIC_BASE_URL=

# Optional social video tools. Leave blank to use executables on the host PATH.
# Use full executable paths when pm2 cannot find them; do not include arguments.
YT_DLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=
# Optional absolute path to a Netscape-format cookie file for restricted posts.
# Treat this file as a secret, keep it outside the repository, and refresh it when it expires.
SOCIAL_COOKIES_FILE=
